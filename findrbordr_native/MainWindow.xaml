<Window
    x:Class="findrbordr_native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Finder Overlay Native"
    Width="1200"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None">

    <Window.Resources>
        <!--  Style Mac Dots Controls  -->
        <Style x:Key="MacDotStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style Capsule Universal  -->
        <Style x:Key="CapsuleStyle" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="30"
                        Opacity="0.1"
                        ShadowDepth="5"
                        Color="#000000" />
                </Setter.Value>
            </Setter>

        </Style>

        <!--  Style Sidebar Item  -->
        <Style x:Key="SideBar" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style Tombol Navigasi  -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4A4A4A" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Outer Cosmetic Frame Border  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="Transparent"
            BorderBrush="White"
            BorderThickness="11"
            CornerRadius="23"
            IsHitTestVisible="False" />

        <!--  =========================================================  -->
        <!--  1. TOP TOOLBAR AREA  -->
        <!--  =========================================================  -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,4,0,4"
            Background="Transparent">
            <Grid.RenderTransform>
                <TranslateTransform Y="3" />
            </Grid.RenderTransform>


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  CAPSULE 1: NAV  -->
            <Border
                Grid.Column="0"
                Margin="4,0,12,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnBack"
                        Width="26"
                        Height="24"
                        Click="BtnBack_Click"
                        Content="‹"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Back" />

                    <Button
                        x:Name="BtnUp"
                        Width="4"
                        Height="24"
                        Click="BtnUp_Click"
                        Content="|"
                        FontSize="18"
                        FontWeight="Bold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Up" />

                    <Button
                        x:Name="BtnForward"
                        Width="26"
                        Height="24"
                        Click="BtnForward_Click"
                        Content="›"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Forward" />
                </StackPanel>
            </Border>

            <!--  TITLE BAR  -->
            <Border Grid.Column="1">

                <TextBlock
                    x:Name="TxtTitle"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#2C3E50"
                    Text="Explorer" />
            </Border>

            <!--  CAPSULE 2: VIEW MODES  -->
            <Border
                Grid.Column="2"
                Margin="12,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnViewIcons"
                        Width="26"
                        Height="24"
                        Click="BtnViewIcons_Click"
                        Content="░"
                        FontSize="14"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Icons View" />
                    <Button
                        x:Name="BtnViewList"
                        Width="26"
                        Height="24"
                        Click="BtnViewList_Click"
                        Content="▥"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="List View" />
                    <Button
                        x:Name="BtnViewDetails"
                        Width="26"
                        Height="24"
                        Click="BtnViewDetails_Click"
                        Content="≡"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Details View" />
                    <Button
                        x:Name="BtnViewTiles"
                        Width="26"
                        Height="24"
                        Click="BtnViewTiles_Click"
                        Content="⊞"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Tiles View" />
                </StackPanel>
            </Border>

            <!--  CAPSULE 3: PREVIEW PANES  -->
            <Border
                Grid.Column="3"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnTogglePreview"
                        Width="26"
                        Height="24"
                        Click="BtnTogglePreview_Click"
                        Content="◧"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Toggle Preview Pane" />
                    <Rectangle
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        Fill="#DCDCDC" />
                    <Button
                        x:Name="BtnToggleDetailsPane"
                        Width="26"
                        Height="24"
                        Click="BtnToggleDetailsPane_Click"
                        Content="◨"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Toggle Details Pane" />
                </StackPanel>
            </Border>

            <!--  CAPSULE 4: OPTIONS  -->
            <Border
                Grid.Column="4"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnProperties"
                        Width="26"
                        Height="24"
                        Click="BtnProperties_Click"
                        Content="ⓘ"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Properties" />
                    <Button
                        x:Name="BtnFolderOptions"
                        Width="26"
                        Height="24"
                        Click="BtnFolderOptions_Click"
                        Content="⚙"
                        FontSize="13"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Folder Options" />
                    <Button
                        x:Name="BtnContextMenu"
                        Width="26"
                        Height="24"
                        Click="BtnContextMenu_Click"
                        Content="•••"
                        FontSize="11"
                        FontWeight="Bold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Context Menu" />
                </StackPanel>
            </Border>

            <!--  SEARCH BUTTON  -->
            <Border
                Grid.Column="5"
                Width="36"
                Height="36"
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource CapsuleStyle}">
                <Button
                    x:Name="BtnSearch"
                    Width="28"
                    Height="28"
                    HorizontalContentAlignment="Center"
                    Click="BtnSearch_Click"
                    Content="🔍"
                    FontSize="13"
                    Style="{StaticResource NavButtonStyle}"
                    ToolTip="Search (Ctrl+F)" />
            </Border>
        </Grid>

        <!--  =========================================================  -->
        <!--  2. LEFT SIDEBAR AREA (PURE WPF PARALLAX GLASS MASK)  -->
        <!--  =========================================================  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="0,2,0,0"
            ContextMenuOpening="Sidebar_ContextMenuOpening">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="BtnRelaunch_Click" Header="Relaunch App" />
                    <Separator />
                    <MenuItem Click="BtnExit_Click" Header="Exit App" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!--  =========================================================  -->
            <!--  LAYER 1: Base panel putih  -->
            <!--  =========================================================  -->
            <Border
                Margin="8"
                Background="White"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="30"
                        Opacity="0.1"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>
            </Border>

            <Border
                Margin="8"
                Background="White"
                
                CornerRadius="20">
                
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="40"
                        Opacity="0.07"
                        ShadowDepth="5"
                        Color="#000000" />
                </Border.Effect>
            </Border>
            <!--  =========================================================  -->
            <!--  LAYER 2: Wallpaper Parallax  -->
            <!--  =========================================================  -->
            <Border
                x:Name="SidebarGlassBorder"
                Margin="8"
                Background="#33FFFFFF"
                IsHitTestVisible="False"
                CornerRadius="20">

                <!--  Masking agar efek Blur terpotong sempurna sesuai CornerRadius  -->
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                                Background="Black"
                                CornerRadius="20" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Grid>
                    <!--  Canvas tempat Wallpaper + Blur Effect  -->
                    <Grid x:Name="ParallaxCanvas" ClipToBounds="True">
                        <Grid.Effect>
                            <BlurEffect Radius="70" RenderingBias="Quality"/>
                        </Grid.Effect>
                    </Grid>
                </Grid>
            </Border>

            <!--  ========================================================  -->
            <!--  [Layar 3] Foreground Controls UI + SPECULAR LIGHT LIQUID GLASS BORDER  -->
            <!--  ========================================================  -->
            <Border
                Margin="6.5"
                BorderThickness="1.5"
                CornerRadius="20">

                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.4" Color="#33FFFFFF" />
                        <GradientStop Offset="0.7" Color="#10FFFFFF" />
                        <GradientStop Offset="1.0" Color="#99FFFFFF" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#D9FFFFFF" />
                </Border.Background>
                <ScrollViewer Margin="10,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarContainer">

                        <!--  Mac Traffic Controls  -->
                        <StackPanel Margin="4,0,0,14" Orientation="Horizontal">
                            <Button
                                Background="#FF5F56"
                                Click="BtnClose_Click"
                                Style="{StaticResource MacDotStyle}" />
                            <Button
                                Background="#FFBD2E"
                                Click="BtnMinimize_Click"
                                Style="{StaticResource MacDotStyle}" />
                            <Button
                                Background="#27C93F"
                                Click="BtnMaximize_Click"
                                Style="{StaticResource MacDotStyle}" />
                        </StackPanel>

                        <!--  Navigation Shortcuts Bawaan  -->
                        <Button
                            Click="Nav_Click"
                            Content="Recents"
                            Style="{StaticResource SideBar}"
                            Tag="shell:::{679F85CB-0220-4080-B29B-5540CC05AAB6}" />

                        <TextBlock
                            Margin="8,10,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#8E8E93"
                            Text="Favorites" />
                        <Button
                            Click="Nav_Click"
                            Content="Applications"
                            Style="{StaticResource SideBar}"
                            Tag="shell:AppsFolder" />
                        <Button
                            Click="Nav_Click"
                            Content="Desktop"
                            Style="{StaticResource SideBar}"
                            Tag="Desktop" />
                        <Button
                            Click="Nav_Click"
                            Content="Documents"
                            Style="{StaticResource SideBar}"
                            Tag="MyDocuments" />

                        <Border
                            x:Name="DropZoneBorder"
                            Padding="2"
                            AllowDrop="True"
                            Background="Transparent"
                            CornerRadius="8"
                            PreviewDragOver="DropZone_DragOver"
                            PreviewDrop="DropZone_Drop">

                            <ItemsControl x:Name="CustomShortcutsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  Tombol Shortcut Dinamis  -->
                                        <Button
                                            Click="Nav_Click"
                                            Content="{Binding Title}"
                                            Style="{StaticResource SideBar}"
                                            Tag="{Binding Path}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="BtnDeleteShortcut_Click" Header="Delete" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock
                            Margin="8,10,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#8E8E93"
                            Text="Locations" />
                        <Button
                            Click="Nav_Click"
                            Content="UserDir"
                            Style="{StaticResource SideBar}"
                            Tag="UserProfile" />
                        <Button
                            Click="Nav_Click"
                            Content="OS Disk (C:)"
                            Style="{StaticResource SideBar}"
                            Tag="C:\" />

                        <!--  =========================================================  -->
                        <!--  SECTION BARU: CUSTOM SHORTCUTS (DRAG & DROP ZONE)  -->
                        <!--  =========================================================  -->



                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
