<Window
    x:Class="findrbordr_native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Finder Overlay Native"
    Width="1200"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None">

    <Window.Resources>

        <!--  Dynamic Resources  -->
        <SolidColorBrush x:Key="CapsuleBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="MainTextBrush" Color="#2C3E50" />
        <SolidColorBrush x:Key="OuterFrameBrush" Color="White" />

        <!--  MenuItem  -->
        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="4,4,4,4" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <!--  Menu Hover  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CapsuleBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource CapsuleBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  ContextMenu  -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CapsuleBackgroundBrush}" />
            <!--  Warna Background Dark  -->
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!--  Border dengan CornerRadius (Sudut Melengkung)  -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="#888888"
                            BorderThickness="1.5"
                            CornerRadius="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--  Style ScrollBar Thumb  -->
        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle
                            x:Name="rectangle"
                            Width="5"
                            Margin="0,2,2,2"
                            HorizontalAlignment="Right"
                            Fill="#60000000"
                            RadiusX="2.5"
                            RadiusY="2.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rectangle" Property="Fill" Value="#A0000000" />
                                <Setter TargetName="rectangle" Property="Width" Value="7" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="rectangle" Property="Fill" Value="#C0000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style ScrollBar Universal  -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid
                            x:Name="Bg"
                            Background="Transparent"
                            SnapsToDevicePixels="true">
                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="true"
                                IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="1"
                                    Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0"
                                    Duration="0:0:0.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseCaptureWithin" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Style Window Traffic Light Dots (macOS Style)  -->
        <Style x:Key="MacDotStyle" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style Capsule Universal  -->
        <Style x:Key="CapsuleStyle" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource CapsuleBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!--  Masukkan LinearGradientBrush ke BorderBrush  -->
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Offset="0.1" Color="#50FFFFFF" />
                        <GradientStop Offset="1.0" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="62"
                        Opacity="0.1"
                        ShadowDepth="0"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style Sidebar Item  -->
        <Style x:Key="SideBar" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Tag" Value="" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20888888" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style Tombol Navigasi  -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2.5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20888888" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="185" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Outer Cosmetic Frame Border  -->
        <Border
            x:Name="OuterCosmeticFrameBorder"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="Transparent"
            BorderBrush="{DynamicResource OuterFrameBrush}"
            BorderThickness="10"
            CornerRadius="26"
            IsHitTestVisible="False" />

        <!--  =================== 1. TOP TOOLBAR AREA ===================  -->
        <Grid
            x:Name="ToolbarGrid"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,2,0,4"
            Background="Transparent"
            ContextMenuOpening="Toolbar_ContextMenuOpening">
            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                    <MenuItem
                        Click="BtnSettings_Click"
                        Header="Settings"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <MenuItem
                        Click="BtnReloadJson_Click"
                        Header="Apply Settings"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <Separator Margin="4,1" Background="#333333" />
                    <MenuItem
                        Click="BtnRelaunch_Click"
                        Header="Relaunch App"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <Separator Margin="4,1" Background="#333333" />
                    <MenuItem
                        Click="BtnExit_Click"
                        Header="Exit App"
                        Style="{StaticResource ModernMenuItemStyle}" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  CAPSULE 1: NAV  -->
            <Border
                Grid.Column="0"
                Margin="4,0,12,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnBack"
                        Width="26"
                        Height="24"
                        Click="BtnBack_Click"
                        Content="‹"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Back" />
                    <Button
                        x:Name="BtnUp"
                        Width="4"
                        Height="24"
                        Click="BtnUp_Click"
                        Content="|"
                        FontSize="18"
                        FontWeight="Bold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Up" />
                    <Button
                        x:Name="BtnForward"
                        Width="26"
                        Height="24"
                        Click="BtnForward_Click"
                        Content="›"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Forward" />
                </StackPanel>
            </Border>

            <!--  TITLE BAR  -->
            <Border Grid.Column="1">
                <TextBlock
                    x:Name="TxtTitle"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MainTextBrush}"
                    Text="Explorer" />
            </Border>

            <!--  CAPSULE 2: VIEW MODES  -->
            <Border
                Grid.Column="2"
                Margin="12,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnViewIcons"
                        Width="26"
                        Height="24"
                        Click="BtnViewIcons_Click"
                        Content="⊞"
                        FontSize="14"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Icons View" />
                    <Button
                        x:Name="BtnViewDetails"
                        Width="26"
                        Height="24"
                        Click="BtnViewDetails_Click"
                        Content="≡"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Details View" />
                    <Button
                        x:Name="BtnViewList"
                        Width="26"
                        Height="24"
                        Click="BtnViewList_Click"
                        Content="▥"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="List View" />
                    <Button
                        x:Name="BtnViewTiles"
                        Width="26"
                        Height="24"
                        Click="BtnViewTiles_Click"
                        Content="⧉"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Tiles View" />
                </StackPanel>
            </Border>

            <!--  CAPSULE 3: PREVIEW PANES  -->
            <Border
                Grid.Column="3"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnTogglePreview"
                        Width="26"
                        Height="24"
                        Click="BtnTogglePreview_Click"
                        Content="◧"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Toggle Preview Pane" />
                    <Rectangle
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        Fill="#808080" />
                    <Button
                        x:Name="BtnToggleDetailsPane"
                        Width="26"
                        Height="24"
                        Click="BtnToggleDetailsPane_Click"
                        Content="◨"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Toggle Details Pane" />
                    <Button
                        x:Name="BtnSort"
                        Click="BtnSort_Click"
                        Content="▼"
                        Style="{StaticResource NavButtonStyle}"
                        Visibility="Collapsed">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                <MenuItem
                                    Click="SortOption_Click"
                                    Header="Name"
                                    Style="{StaticResource ModernMenuItemStyle}"
                                    Tag="n" />
                                <MenuItem
                                    Click="SortOption_Click"
                                    Header="Date modified"
                                    Style="{StaticResource ModernMenuItemStyle}"
                                    Tag="d" />
                                <MenuItem
                                    Click="SortOption_Click"
                                    Header="Type"
                                    Style="{StaticResource ModernMenuItemStyle}"
                                    Tag="t" />
                                <Separator Margin="4,2" Background="#333333" />
                                <MenuItem
                                    Click="SortOption_Click"
                                    Header="Ascending"
                                    Style="{StaticResource ModernMenuItemStyle}"
                                    Tag="a" />
                                <MenuItem
                                    Click="SortOption_Click"
                                    Header="Descending"
                                    Style="{StaticResource ModernMenuItemStyle}"
                                    Tag="d" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                </StackPanel>
            </Border>

            <!--  CAPSULE 4: OPTIONS  -->
            <Border
                Grid.Column="4"
                Margin="4,0,4,0"
                Padding="4,0"
                Style="{StaticResource CapsuleStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnProperties"
                        Width="26"
                        Height="24"
                        Click="BtnProperties_Click"
                        Content="ⓘ"
                        FontSize="16"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Properties" />
                    <Button
                        x:Name="BtnFolderOptions"
                        Width="26"
                        Height="24"
                        Click="BtnFolderOptions_Click"
                        Content="⚙"
                        FontSize="13"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Folder Options" />
                    <Button
                        x:Name="BtnContextMenu"
                        Width="26"
                        Height="24"
                        Click="BtnContextMenu_Click"
                        Content="•••"
                        FontSize="11"
                        FontWeight="Bold"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Context Menu" />
                </StackPanel>
            </Border>

            <!--  SEARCH BUTTON  -->
            <Border
                Grid.Column="5"
                Width="36"
                Height="36"
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource CapsuleStyle}">
                <Button
                    x:Name="BtnSearch"
                    Width="28"
                    Height="28"
                    HorizontalContentAlignment="Center"
                    Click="BtnSearch_Click"
                    Content="🔎︎"
                    FontSize="13"
                    Style="{StaticResource NavButtonStyle}"
                    ToolTip="Search (Ctrl+F)" />
            </Border>
        </Grid>

        <!--  =================== 2. LEFT SIDEBAR AREA ===================  -->

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="0,0,0,0"
            ContextMenuOpening="Sidebar_ContextMenuOpening">
            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                    <MenuItem
                        Click="BtnSettings_Click"
                        Header="Settings"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <MenuItem
                        Click="BtnReloadJson_Click"
                        Header="Apply Settings"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <Separator Margin="4,1" Background="#333333" />
                    <MenuItem
                        Click="BtnRelaunch_Click"
                        Header="Relaunch App"
                        Style="{StaticResource ModernMenuItemStyle}" />
                    <Separator Margin="4,1" Background="#333333" />
                    <MenuItem
                        Click="BtnExit_Click"
                        Header="Exit App"
                        Style="{StaticResource ModernMenuItemStyle}" />
                </ContextMenu>
            </Grid.ContextMenu>
            <!--  LAYER 1: Base Shadow Panel  -->
            <Border
                x:Name="LeftSidebarShadowBorder"
                Margin="6"
                Background="{DynamicResource CapsuleBackgroundBrush}"
                CornerRadius="26">
                <Border.Effect>
                    <DropShadowEffect
                        Direction="0"
                        BlurRadius="25"
                        Opacity="0.12"
                        ShadowDepth="7"
                        Color="#000000" />
                </Border.Effect>
            </Border>

            <!--  LAYER 2: Wallpaper Parallax Glass Effect  -->
            <Border
    x:Name="SidebarGlassBorder"
    Margin="6"
    CornerRadius="26"
    BorderThickness="1.1"
    IsHitTestVisible="False">

    <!-- 1. AMBIENT SHADOW: Membuat kaca "melayang" & menonjol di atas background PUTIH -->
    <Border.Effect>
        <DropShadowEffect 
            BlurRadius="25" 
            Opacity="0.18" 
            ShadowDepth="4" 
            Direction="270" 
            Color="#000000"/>
    </Border.Effect>

    <!-- 2. BACKGROUND ADAPTIF: Campuran Hitam-Putih Transparan (Bukan Putih Tebal!) -->
    <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <!-- Sedikit putih terang di top-left untuk pantulan cahaya -->
            <GradientStop Color="#40FFFFFF" Offset="0.0" />
            <!-- Tint agak gelap di bottom-right agar kontras dengan canvas putih -->
            <GradientStop Color="#15000000" Offset="1.0" />
        </LinearGradientBrush>
    </Border.Background>

    <!-- 3. BORDER 3D CONTRAST: Terlihat di Hitam & Putih -->
    <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <!-- Top-Left: Pantulan Putih (Menyala di Background Hitam) -->
            <GradientStop Color="#B0FFFFFF" Offset="0.0" />
            <GradientStop Color="#30FFFFFF" Offset="0.4" />
            
            <!-- Bottom-Right: Garis Penegas Gelap (Membatasi Kaca di Background Putih) -->
            <GradientStop Color="#B0FFFFFF" Offset="0.7" />
            <GradientStop Color="#30FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
    </Border.BorderBrush>

    <!-- OPACITY MASK (Tetap Menggunakan Milik Anda) -->
    <Border.OpacityMask>
        <VisualBrush>
            <VisualBrush.Visual>
                <Border
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                    Background="White"
                    CornerRadius="29" />
            </VisualBrush.Visual>
        </VisualBrush>
    </Border.OpacityMask>

    <Grid x:Name="ParallaxCanvas" ClipToBounds="True" />
</Border>

            <!--  LAYER 3: UI Controls & Dynamic Shortcuts  -->
            <Border
                x:Name="Layer3Border"
                Margin="6"
                BorderThickness="1.5"
                CornerRadius="24">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#60FFFFFF" />
                        <GradientStop Offset="0.25" Color="#25FFFFFF" />
                        <GradientStop Offset="0.65" Color="#05FFFFFF" />
                        <GradientStop Offset="1.0" Color="#60FFFFFF" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#E6FFFFFF" />
                </Border.Background>

                <ScrollViewer Margin="10,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarContainer">
                        <!--  Navigation Shortcuts Bawaan System  -->
                        <TextBlock
                            Margin="8,30,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#8E8E93"
                            Text="Favorites" />
                        <Button
                            Click="Nav_Click"
                            Content="Applications"
                            Style="{StaticResource SideBar}"
                            Tag="shell:AppsFolder" />
                        <Button
                            Click="Nav_Click"
                            Content="Desktop"
                            Style="{StaticResource SideBar}"
                            Tag="Desktop" />
                        <Button
                            Click="Nav_Click"
                            Content="Documents"
                            Style="{StaticResource SideBar}"
                            Tag="MyDocuments" />

                        <!--  CUSTOM SHORTCUTS AREA (Data Binding dari JSON)  -->
                        <Border
                            x:Name="DropZoneBorder"
                            Padding="2"
                            AllowDrop="True"
                            Background="Transparent"
                            CornerRadius="8"
                            PreviewDragOver="DropZone_DragOver"
                            PreviewDrop="DropZone_Drop">
                            <ItemsControl x:Name="CustomShortcutsList" ItemsSource="{Binding CustomShortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Click="Nav_Click"
                                            Content="{Binding Title}"
                                            Style="{StaticResource SideBar}"
                                            Tag="{Binding Path}">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                                    <MenuItem
                                                        Click="BtnDeleteShortcut_Click"
                                                        Header="Delete"
                                                        Style="{StaticResource ModernMenuItemStyle}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock
                            Margin="8,10,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#8E8E93"
                            Text="Locations" />
                        <Button
                            Click="Nav_Click"
                            Content="{Binding UserProfileName}"
                            Style="{StaticResource SideBar}"
                            Tag="UserProfile" />
                        <Button
                            Click="Nav_Click"
                            Content="This PC"
                            Style="{StaticResource SideBar}"
                            Tag="shell:::{20D04FE0-3AEA-1069-A2D8-08002B30309D}" />
                        <Button
                            Click="Nav_Click"
                            Content="Trash"
                            Style="{StaticResource SideBar}"
                            Tag="shell:::{645FF040-5081-101B-9F08-00AA002F954E}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!--  LAYER 4 (Paling Atas): Mac Dot berdiri sendiri di luar Layer 3  -->
            <StackPanel
                Margin="20,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    x:Name="DotClose"
                    Background="#FF5F56"
                    Click="BtnClose_Click"
                    Style="{StaticResource MacDotStyle}" />
                <Button
                    x:Name="DotMinimize"
                    Background="#FFBD2E"
                    Click="BtnMinimize_Click"
                    Style="{StaticResource MacDotStyle}" />
                <Button
                    x:Name="DotMaximize"
                    Background="#27C93F"
                    Click="BtnMaximize_Click"
                    Style="{StaticResource MacDotStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
